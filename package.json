{
  "name": "@rhombus.rocks/fngit",
  "version": "0.0.0",
  "description": "Locate git repos from short references and clone them the configured way — a library plus a decorator over the git CLI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "fngit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test --pass-with-no-tests",
    "lint": "tsc --noEmit -p tsconfig.json && eslint .",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "dependencies": {
    "@rhombus-toolkit/type-guards": "^3.1.0",
    "@rhombus-toolkit/types": "^1.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "dprint": "^0.57.1",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhombus-rocks/fngit.git"
  },
  "homepage": "https://github.com/rhombus-rocks/fngit#readme",
  "bugs": {
    "url": "https://github.com/rhombus-rocks/fngit/issues"
  }
}
